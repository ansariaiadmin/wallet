# Smart Wallet — runtime configuration
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is not, so it
# must never contain a real secret. Every value is optional: the API starts
# with a safe default when a variable is absent.
#
#   cp .env.example .env

# --- Auth -------------------------------------------------------------------
# Secret the /auth JWT tokens are signed with. 64 hex characters, or base64 of
# at least 32 bytes. When unset, a random secret is generated for the life of
# the process, which invalidates every token on restart — fine for development,
# wrong for production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# --- Persistence ------------------------------------------------------------
# Directory the FileKeyStore keeps encrypted mnemonics in. When unset, no
# mnemonic is written to disk and registering a wallet returns an id only.
KEYSTORE_DIR=./data/keystore

# --- HTTP -------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# --- Live chains (optional) -------------------------------------------------
# Override the built-in endpoint lists. Leave empty to use the public endpoints
# the chain registry ships with. Never put an API key that grants spending
# power in here — these are read-only RPC URLs.
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
SOLANA_RPC_URL=
SOLANA_DEVNET_RPC_URL=
TRON_RPC_URL=

# --- Test gates -------------------------------------------------------------
# Both are opt-in and off by default: the suite is otherwise fully offline.
#   RUN_INTEGRATION=1 pnpm --filter @wallet/chains test:integration
RUN_INTEGRATION=0
# End-to-end tests against live testnets. Needs the RPC URLs above and a
# funded throwaway key in E2E_FUNDED_KEY, which is read from the environment
# and never committed.
RUN_E2E=0

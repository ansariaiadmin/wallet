# ============================================
# Wallet — Universal Wallet OS — .env.example — جادوگر v3.0.0 — پشتیبانی صفر — Zero Support
# توضیح فارسی برای هر متغیر — فقط ضروری‌ها — بقیه خودکار — کپی: cp .env.example .env — بعد: ./install.sh — جادوگر همه چی رو می‌پرسه با راهنما همون‌جا
# ============================================

# --- دیتابیس — Database — خودکار — جادوگر می‌سازه ---
# چیه؟ جایی که اطلاعات ذخیره می‌شه — مثل انبار — کیف پول + تراکنش‌ها + ledger
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet
POSTGRES_USER=wallet
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=wallet

# --- ردیس — Redis — کش — خودکار ---
REDIS_URL=redis://localhost:6379/0

# --- امنیت — Security — خودکار — جادوگر رمز بانکی 32 کاراکتری می‌سازه ---
# چیه؟ رمزهای امنیتی — مثل رمز بانکی — جادوگر خودش می‌سازه
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-openssl-rand-base64-32
ENCRYPTION_KEY=change-me-32-byte-base64
JWT_SECRET=change-me-openssl-rand-base64-32
JWT_ACCESS_SECRET=change-me-openssl-rand-base64-32
JWT_REFRESH_SECRET=change-me-openssl-rand-base64-32
ENCRYPTION_MASTER_KEY=change-me-32-byte-base64

# --- AI Provider — پرووایدر هوش مصنوعی — با راهنما همون‌جا ---
# چیه؟ شرکتی که هوش مصنوعی می‌ده — برای تحلیل کیف پول
# گزینه‌ها: openai (GPT-4), anthropic (Claude), google (Gemini), openrouter (هر مدل), mock (بدون AI واقعی — برای تست)
# کجا بگیرم؟ https://platform.openai.com/api-keys → Create key → sk-proj-...
# مثال: sk-proj-abc123...
AI_PROVIDER=mock
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
AI_BASE_URL=
AI_API_KEY=
AI_EMBEDDING_DIMENSION=1024
AI_ROUTING_MODE=iranian_gateway

# --- SMS — پنل پیامکی — برای ناتیف کیف پول ---
# چیه؟ وقتی کیف پول شارژ می‌شه یا کسر می‌شه پیامک می‌ره
# گزینه‌ها: ghasedak (https://ghasedak.me/ — رایگان 50 تا), kavenegar (https://kavenegar.com/), mock (تو لاگ)
# کجا بگیرم؟ https://ghasedak.me/ → ثبت‌نام → API Key
SMS_PROVIDER=mock
SMS_API_KEY=ghasedak-key
SMS_SENDER=10008566
GHASEDAK_API_KEY=ghasedak-key
KAVENEGAR_API_KEY=kavenegar-key

# --- Payment — پرداخت — زرین‌پال — برای شارژ کیف پول ---
# چیه؟ درگاه پرداخت ایرانی — کاربر کیف پول شارژ می‌کنه — پول می‌ره زرین‌پال
# گزینه‌ها: zarinpal (واقعی — https://next.zarinpal.com/ → API), mock (تست بدون پول)
# کجا بگیرم؟ https://next.zarinpal.com/panel/api → API Key
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=

# --- Email — ایمیل ---
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=pass

# --- S3 — بکاپ offsite ---
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY=access
S3_SECRET_KEY=secret
S3_BUCKET=wallet-backups
BACKUP_ENCRYPTION_KEY=backup-enc-key-32-bytes

# --- Notification System — سیستم ناتیف — سقف 10/10 — جدید v3.0.0 ---
# چیه؟ اطلاع‌رسانی شارژ + کسر + تراکنش — کانال‌ها: in_app (همیشه روشن) + sms (شارژ کیف پول — مهم) + email + telegram (برای ادمین — تراکنش جدید)
# تلگرام: @BotFather → /newbot → توکن → chat_id
NOTIF_IN_APP=true
NOTIF_EMAIL=false
NOTIF_SMS=true
NOTIF_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- PWA + E-Signature — سقف 10/10 — همیشه روشن ---
PWA_ENABLED=true
ESIGNATURE_ENABLED=true
TELEPHONY_PROVIDER=mock
PORT=3000
API_PORT=3001
LOG_LEVEL=info

# --- Fallback + Throttling — تاریکی روشن شد — v3.1.0 ---
# چیه؟ اگر یه پرووایدر خراب شد چی؟ fallback — اگر SMS fail شد in_app+email می‌ره — امن
# throttling چیه؟ اگر 5 SMS در 1 دقیقه بیاد خلاصه می‌شه — هزینه کنترل — spam جلوگیری
SMS_FALLBACK_PROVIDERS=ghasedak,kavenegar,mock
SMS_THROTTLING_ENABLED=true
SMS_THROTTLING_MAX_PER_MINUTE=5
NOTIF_FALLBACK_ENABLED=true
NOTIF_THROTTLING_ENABLED=true
NOTIF_THROTTLING_MAX_PER_MINUTE=10
NOTIF_THROTTLING_DIGEST_ENABLED=true

# --- Storage ---
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/app/uploads
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NODE_ENV=development

# --- Outbox Relay — برای wallet — double-entry — BigInt — RLS ---
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=30000
OUTBOX_JITTER_RATIO=0.2
OUTBOX_WEBHOOK_URL=http://localhost:3000/webhook/outbox
OUTBOX_WEBHOOK_TIMEOUT_MS=5000
